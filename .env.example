# Copy to .env and edit. Every value is optional.
KITTYSON_TZ=Asia/Seoul
KITTYSON_LAT=37.5665
KITTYSON_LON=126.9780
KITTYSON_DATA_DIR=data

# 로그 파일(data/logs/app.log) 상한: 파일 하나 최대 MB, 보관 개수. 합계 = MB × (개수 + 1)
# KITTYSON_LOG_MAX_MB=5
# KITTYSON_LOG_BACKUPS=3

# 고양이 사진은 pixabay.com 에서 받는다 (무료 키: 로그인하면 https://pixabay.com/api/docs/ 에 나온다). 없으면 새 고양이를 만들지 못한다.
# KITTYSON_PIXABAY_KEY=
# Pixabay 사진이 고양이인지 보는 모델. 아래 Claude 토큰이 있어야 본다.
# KITTYSON_CAT_MODEL=claude-opus-5-5

# 오늘의 명언(quote)을 Claude가 고르게 하려면 둘 중 하나. `claude setup-token`으로 발급한 구독 토큰.
# 없으면 정해 둔 목록에서 고른다. 로컬은 `claude` 로그인 상태면 없어도 된다.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# KITTYSON_QUOTE_MODEL=claude-opus-5-5

# 그날 고양이나 명언을 만들지 못했을 때 텔레그램으로 알림을 받으려면 둘 다.
# 토큰은 텔레그램의 @BotFather 에서 봇을 만들면 나오고, 채팅 id는 그 봇에게 말을 건 내 채팅의 숫자 id다. 없으면 로그에만 남는다.
# KITTYSON_TELEGRAM_TOKEN=
# KITTYSON_TELEGRAM_CHAT=

# 배포 서버 전용: Cloudflare Tunnel로 공개 HTTPS를 열 때만 (Zero Trust → Networks → Tunnels)
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
