# Copy to .env and edit. Every value is optional.
KITTYSON_TZ=Asia/Seoul
KITTYSON_LAT=37.5665
KITTYSON_LON=126.9780
KITTYSON_DATA_DIR=data
KITTYSON_PORT=8000

# 한 마디(fortune)를 Claude가 쓰게 하려면 둘 중 하나. `claude setup-token`으로 발급한 구독 토큰.
# 없으면 문장 목록에서 고른다. 로컬은 `claude` 로그인 상태면 없어도 된다.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# KITTYSON_FORTUNE_MODEL=haiku

# 배포 서버 전용: Cloudflare Tunnel로 공개 HTTPS를 열 때만 (Zero Trust → Networks → Tunnels)
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
